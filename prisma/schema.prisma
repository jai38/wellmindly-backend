// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  UNIVERSITY
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?
  firstName         String
  lastName          String
  role              Role     @default(STUDENT)
  googleId          String?  @unique
  universityId      String?
  university        University? @relation(fields: [universityId], references: [id])
  quizResults       QuizResult[]
  chatMessages      ChatMessage[]
  dailyCheckins     DailyCheckin[]
  talkNotes         TalkNote[]
  talkReplies       TalkReply[]
  talkReactions     TalkReaction[]
  talkReports       TalkReport[]
  talkNickname      String?   @unique
  talkAvatar        String?
  talkBio           String?   @db.Text
  talkTermsAccepted Boolean   @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String   @unique
  verified  Boolean  @default(false)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quiz {
  id             String   @id @default(uuid())
  title          String
  description    String?  @db.Text
  category       String
  totalQuestions Int
  maxScore       Int
  quizResults    QuizResult[]
  questions      Question[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Question {
  id        String   @id @default(uuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  index     Int
  text      String   @db.Text
  type      String   @default("MULTIPLE_CHOICE")
  options   QuestionOption[]
  createdAt DateTime @default(now())
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  points     Int
}

model QuizResult {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  overallScore   Int
  classification String
  completedAt    DateTime      @default(now())
  feedback       QuizFeedback?

  @@index([userId, completedAt])
}

model QuizFeedback {
  id        String     @id @default(uuid())
  resultId  String     @unique
  result    QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  rating    Int
  comments  String?    @db.Text
  createdAt DateTime   @default(now())
}

enum Sender {
  USER
  AI
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    Sender
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String
  feature   String
  createdAt DateTime @default(now())

  @@unique([email, feature])
}

model DailyCheckin {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CrisisHotline {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  phone       String
  website     String
  category    String
  country     String
  createdAt   DateTime @default(now())

  @@index([category])
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UniversityOnboarding {
  id             String   @id @default(uuid())
  name           String
  email          String
  universityName String
  role           String
  phone          String?
  message        String   @db.Text
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model CounselorOnboarding {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  credentials String
  experience  String   @db.Text
  message     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum TalkStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum ReactionType {
  SUPPORT
  HUG
  METOO
}

model TalkRoom {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?    @db.Text
  isActive    Boolean    @default(true)
  notes       TalkNote[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TalkNote {
  id           String         @id @default(uuid())
  roomId       String
  room         TalkRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname     String
  avatar       String
  content      String         @db.Text
  status       TalkStatus     @default(APPROVED)
  meTooCount   Int            @default(0)
  isReported   Boolean        @default(false)
  aiScore      Float?
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  moderationReason String?        @db.Text
  replies          TalkReply[]
  reactions        TalkReaction[]
  reports          TalkReport[]
  createdAt        DateTime       @default(now())

  @@index([roomId, status, createdAt])
  @@index([userId, createdAt])
}

model TalkReply {
  id           String       @id @default(uuid())
  noteId       String
  note         TalkNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname     String
  avatar       String
  content      String       @db.Text
  status       TalkStatus   @default(APPROVED)
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  moderationReason String?      @db.Text
  reports          TalkReport[]
  createdAt        DateTime     @default(now())

  @@index([noteId, status, createdAt])
  @@index([userId, createdAt])
}

model TalkReaction {
  id        String       @id @default(uuid())
  noteId    String
  note      TalkNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([noteId, userId, type])
}

model TalkReport {
  id        String     @id @default(uuid())
  noteId    String?
  note      TalkNote?  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     TalkReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?    @db.Text
  createdAt DateTime   @default(now())

  @@index([createdAt])
}


